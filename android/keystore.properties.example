# android/keystore.properties 의 **모양만** 보여 주는 예시다(값 없음). 이 파일을 복사해 keystore.properties 로 만들고
# 값을 채운다. keystore.properties 와 *.jks 는 .gitignore 대상이다 — 절대 커밋하지 않는다.
#   cp android/keystore.properties.example android/keystore.properties
# storeFile 은 android/ 기준 상대 경로다.
storeFile=../../secure/sunmoon-upload.jks
storePassword=
keyAlias=upload
keyPassword=
