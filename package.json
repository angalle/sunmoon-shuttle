{
  "name": "sunmoon-shuttle",
  "private": true,
  "version": "1.0.0",
  "description": "선문대 셔틀버스 시간표 앱 — 오프라인 우선 PWA (비공식)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo": "bash scripts/serve-demo.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:offline": "node scripts/offline_smoke.mjs",
    "scrape": "tsx tools/scraper/index.ts",
    "extract": "tsx tools/extract/index.ts",
    "lint:boundary": "bash scripts/boundary.sh",
    "cap:sync": "cap sync android",
    "android:build": "bash android/build-release.sh"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  }
}
